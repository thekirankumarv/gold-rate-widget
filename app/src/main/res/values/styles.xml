<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Col">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:src">@drawable/divider</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">#1B1408</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="Price">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">—</item>
        <item name="android:textColor">#FFF4D6</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="GstLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:text">with 3% GST</item>
        <item name="android:textColor">#6B6252</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="Gst">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">—</item>
        <item name="android:textColor">#C9A24A</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
